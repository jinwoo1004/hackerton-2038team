# Documentation template only. Scripts do not auto-load this file.
# Select exactly one explicit runtime/provider pair in your execution environment.

# Local development/demo: official browser OAuth login, dedicated external auth file.
APP_RUNTIME=local
LLM_PROVIDER=codex_oauth
CODEX_MODEL=<explicit-codex-model>
CODEX_AUTH_FILE=<absolute-path-outside-repository-to-dedicated-auth.json>

# Deployment only: supply these through deployment secrets, not this repository.
# APP_RUNTIME=deployed
# LLM_PROVIDER=openai_api
# OPENAI_MODEL=<explicit-openai-model>
# OPENAI_API_KEY=<deployment-secret>

# Network-free tests only: no model or credential inputs are read.
# APP_RUNTIME=test
# LLM_PROVIDER=mock
