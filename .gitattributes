# Binary fixtures and original fonts must survive Windows checkout byte-for-byte.
*.pdf binary
*.docx binary
*.xlsx binary
*.zip binary
*.woff binary
*.woff2 binary
*.ttf binary
*.png binary
*.ico binary
*.jar binary
*.exe binary
# Keep deterministic fixture hashes and generated source ZIP stable after checkout.
/demo-fixtures/*.md text eol=lf
/demo-fixtures/*.json text eol=lf
/demo-fixtures/*.log text eol=lf
/demo-fixtures/source/*.ts text eol=lf
agent/dist/MonitoringAgentSetup.exe filter=lfs diff=lfs merge=lfs -text

# Linux deployment entrypoints must survive Windows checkout.
/deploy/*.sh text eol=lf
/backend/Dockerfile text eol=lf
/service/Dockerfile text eol=lf
