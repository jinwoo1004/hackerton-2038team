# Copy outside the Git checkout, protect with mode 600, then fill every blank required value.
# Never commit the populated file. Docker Compose reads it through --env-file.
OPENAI_MODEL=
OPENAI_API_KEY=
APP_JWT_SECRET=
APP_ANALYSIS_SHARED_SECRET=
DB_USERNAME=monitoring
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Actual Vercel frontend origin; no trailing slash for CORS. Comma-separate exact additional origins.
APP_CORS_ALLOWED_ORIGINS=
APP_PUBLIC_URL=

# Actual public backend hostname, without https:// or a path. Required for TLS mode only.
BACKEND_HOST=
BACKEND_PORT=8080
LLM_TIMEOUT_SECONDS=30

# up.sh uses the checkout commit ID unless explicitly overridden.
# DEPLOY_IMAGE_TAG=
