<Window x:Class="MonitoringAgent.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitoring Agent" Icon="/MonitoringAgentApp;component/Assets/logo_app.png"
        Width="430" Height="720" MinWidth="430" MinHeight="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Malgun Gothic" TextOptions.TextFormattingMode="Ideal">

    <Border Background="White" CornerRadius="28" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.14" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Row="0" Height="52" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <Button Style="{StaticResource CloseButton}" HorizontalAlignment="Right" Margin="0,8,14,0"
                        Click="Close_Click" />
            </Grid>

            <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Padding="32,0,24,32">
                <Grid>

                    <StackPanel x:Name="LanguagePanel" Margin="2,4,2,0">
                        <Image Source="/MonitoringAgentApp;component/Assets/logo_app.png" Width="76" Height="76"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />

                        <StackPanel x:Name="LangRollGroup" Margin="0,22,0,26" RenderTransformOrigin="0.5,0.5">
                            <StackPanel.RenderTransform>
                                <TranslateTransform x:Name="LangRollTransform" />
                            </StackPanel.RenderTransform>
                            <TextBlock x:Name="LangTitle" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource Ink}" HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" LineHeight="32" />
                            <TextBlock x:Name="LangSubtitle" FontSize="15" Foreground="{StaticResource Sub}"
                                       TextAlignment="Center" TextWrapping="Wrap" LineHeight="22" Margin="0,12,0,0" />
                        </StackPanel>

                        <RadioButton x:Name="LangKo" Style="{StaticResource LangOption}" GroupName="Lang" IsChecked="True">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/MonitoringAgentApp;component/Assets/flag_kr.png" Width="28" Height="19" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="한국어" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="LangJa" Style="{StaticResource LangOption}" GroupName="Lang">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/MonitoringAgentApp;component/Assets/flag_jp.png" Width="28" Height="19" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="日本語" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="LangEn" Style="{StaticResource LangOption}" GroupName="Lang">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="/MonitoringAgentApp;component/Assets/flag_us.png" Width="28" Height="19" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="English" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>

                        <Button x:Name="LangNextButton" Style="{StaticResource PrimaryButton}" Margin="0,26,0,4"
                                Click="LangNext_Click" />
                    </StackPanel>

                    <StackPanel x:Name="StartPanel" Margin="2,4,2,0" Visibility="Collapsed">
                        <Image Source="/MonitoringAgentApp;component/Assets/logo_app.png" Width="76" Height="76"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />

                        <TextBlock x:Name="StartTitle" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource Ink}" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" LineHeight="32" Margin="0,22,0,0" />
                        <TextBlock x:Name="StartSubtitle" FontSize="15" Foreground="{StaticResource Sub}"
                                   TextAlignment="Center" TextWrapping="Wrap" LineHeight="22" Margin="0,12,0,0" />

                        <Border Background="{StaticResource Card}" CornerRadius="16" Padding="18,16" Margin="0,26,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <Path Data="{StaticResource IconShield}" Fill="{StaticResource Accent}"
                                          Width="13" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,9,0" />
                                    <TextBlock x:Name="InfoTitle" FontSize="14" FontWeight="Bold"
                                               Foreground="{StaticResource Ink}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="InfoBody" FontSize="13" Foreground="{StaticResource Sub}"
                                           LineHeight="22" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Margin="0,22,0,0"
                                Click="Start_Click" />
                        <TextBlock x:Name="StartFooter" FontSize="12" Foreground="#B0B8C1" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,4" />

                        <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0">
                            <Hyperlink Foreground="{StaticResource Sub}" TextDecorations="None" Click="ChangeLanguage_Click">
                                <InlineUIContainer BaselineAlignment="Center">
                                    <Path Data="{StaticResource IconGlobe}" Stroke="{StaticResource Sub}" StrokeThickness="1.3"
                                          Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" />
                                </InlineUIContainer>
                                <Run x:Name="ChangeLangRun" FontSize="13" />
                            </Hyperlink>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel x:Name="ConnectPanel" Margin="2,4,2,0" Visibility="Collapsed">
                        <Image Source="/MonitoringAgentApp;component/Assets/logo_app.png" Width="60" Height="60"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                        <TextBlock x:Name="ConnectTitle" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource Ink}" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,18,0,0" />
                        <TextBlock x:Name="ConnectSubtitle" FontSize="14" Foreground="{StaticResource Sub}"
                                   TextAlignment="Center" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,0" />

                        <TextBlock x:Name="ServerLabel" Style="{StaticResource FieldLabel}" Margin="2,26,0,7" />
                        <Border x:Name="ServerBox" Style="{StaticResource FieldBox}">
                            <TextBox x:Name="ServerInput" Style="{StaticResource FieldText}" TextChanged="ConnectInput_Changed" />
                        </Border>

                        <TextBlock x:Name="TokenLabel" Style="{StaticResource FieldLabel}" Margin="2,16,0,7" />
                        <Border x:Name="TokenBox" Style="{StaticResource FieldBox}">
                            <TextBox x:Name="TokenInput" Style="{StaticResource FieldText}" FontFamily="Consolas"
                                     FontSize="13" TextChanged="ConnectInput_Changed" />
                        </Border>

                        <Border x:Name="ConnectMessageBox" CornerRadius="12" Padding="14,11" Margin="0,16,0,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="ConnectMessage" FontSize="13" TextWrapping="Wrap" LineHeight="19" />
                        </Border>

                        <Button x:Name="ConnectButton" Style="{StaticResource PrimaryButton}" Margin="0,22,0,0"
                                Click="Connect_Click" />
                        <Button x:Name="ConnectBackButton" Style="{StaticResource GhostButton}" Margin="0,8,0,4"
                                Click="ConnectBack_Click" />
                    </StackPanel>

                    <StackPanel x:Name="LogsPanel" Margin="2,4,2,0" Visibility="Collapsed">
                        <TextBlock x:Name="LogsTitle" FontSize="22" FontWeight="Bold"
                                   Foreground="{StaticResource Ink}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="LogsSubtitle" FontSize="14" Foreground="{StaticResource Sub}"
                                   TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,0" />

                        <StackPanel x:Name="LogList" Margin="0,20,0,0" />
                        <Border x:Name="LogEmpty" Background="{StaticResource Card}" CornerRadius="14" Padding="16,18"
                                Margin="0,20,0,0">
                            <TextBlock x:Name="LogEmptyText" FontSize="13" Foreground="{StaticResource Sub}"
                                       TextAlignment="Center" TextWrapping="Wrap" />
                        </Border>

                        <Button x:Name="AddFolderButton" Style="{StaticResource GhostButton}" Height="46" Margin="0,12,0,0"
                                Click="AddFolder_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconFolder}" Fill="#4E5968" Width="15" Height="13"
                                      Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock x:Name="AddFolderText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="PatternLabel" Style="{StaticResource FieldLabel}" Margin="2,18,0,7" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource FieldBox}">
                                <TextBox x:Name="PatternInput" Style="{StaticResource FieldText}" FontFamily="Consolas"
                                         FontSize="13" KeyDown="PatternInput_KeyDown" />
                            </Border>
                            <Button x:Name="AddPatternButton" Grid.Column="1" Style="{StaticResource GhostButton}"
                                    Height="46" Width="64" FontSize="14" Margin="8,0,0,0" Click="AddPattern_Click" />
                        </Grid>

                        <StackPanel x:Name="SuggestGroup" Margin="0,18,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="SuggestLabel" FontSize="12" Foreground="{StaticResource Sub}" Margin="2,0,0,8" />
                            <WrapPanel x:Name="SuggestPanel" />
                        </StackPanel>

                        <Button x:Name="InstallButton" Style="{StaticResource PrimaryButton}" Margin="0,22,0,0"
                                Click="Install_Click" />
                        <Button x:Name="LogsBackButton" Style="{StaticResource GhostButton}" Margin="0,8,0,4"
                                Click="LogsBack_Click" />
                    </StackPanel>

                    <StackPanel x:Name="ProgressPanel" Margin="2,4,2,0" Visibility="Collapsed">
                        <Image Source="/MonitoringAgentApp;component/Assets/logo_app.png" Width="76" Height="76"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock x:Name="ProgressTitle" FontSize="21" FontWeight="Bold"
                                   Foreground="{StaticResource Ink}" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,24,0,0" />
                        <TextBlock x:Name="ProgressStatus" FontSize="14" Foreground="{StaticResource Sub}"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <ProgressBar IsIndeterminate="True" Height="6" Margin="0,28,0,0"
                                     Background="#F2F4F6" Foreground="#111111" BorderThickness="0" />
                        <StackPanel x:Name="StepsPanel" Margin="0,24,0,4" />
                    </StackPanel>

                    <StackPanel x:Name="DonePanel" Margin="2,4,2,0" Visibility="Collapsed">
                        <Grid Width="72" Height="72" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Ellipse Fill="{StaticResource Brand}" />
                            <Path Stroke="White" StrokeThickness="6" StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M 22,38 L 33,49 L 51,26" />
                        </Grid>
                        <TextBlock x:Name="DoneSubtitle" FontSize="15" Foreground="{StaticResource Sub}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" LineHeight="22" Margin="0,18,0,0" />
                        <Border Background="{StaticResource Card}" CornerRadius="18" Margin="0,22,0,0" Padding="20,6">
                            <StackPanel x:Name="ResultsPanel" />
                        </Border>
                        <Button x:Name="DoneCloseButton" Style="{StaticResource GhostButton}" Margin="0,22,0,4"
                                Click="Close_Click" />
                    </StackPanel>

                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
