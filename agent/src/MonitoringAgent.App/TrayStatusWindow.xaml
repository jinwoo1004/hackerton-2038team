<Window x:Class="MonitoringAgent.App.TrayStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitoring Agent"
        Width="320" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Deactivated="Window_Deactivated"
        FontFamily="Segoe UI, Malgun Gothic" TextOptions.TextFormattingMode="Ideal">

    <Border Background="White" CornerRadius="20" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.16" Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="22,20,22,20">
            <StackPanel Orientation="Horizontal">
                <Image Source="/MonitoringAgentApp;component/Assets/logo_app.png" Width="38" Height="38" VerticalAlignment="Center" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Monitoring Agent" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Brand}" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Ellipse x:Name="StateDot" Width="8" Height="8" Fill="#22C55E" VerticalAlignment="Center" />
                        <TextBlock x:Name="TrayStatusText" FontSize="12.5" Foreground="{StaticResource Sub}"
                                   Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <Border Background="{StaticResource Card}" CornerRadius="14" Padding="16,4" Margin="0,18,0,0">
                <StackPanel x:Name="StatusPanel" />
            </Border>

            <Button x:Name="SyncButton" Style="{StaticResource PrimaryButton}" Height="46" Margin="0,16,0,0"
                    Click="Sync_Click" />
            <Button x:Name="OpenLogButton" Style="{StaticResource GhostButton}" Height="46" Margin="0,8,0,0"
                    Click="OpenLog_Click" />
            <Button x:Name="QuitButton" Style="{StaticResource GhostButton}" Height="46" Margin="0,8,0,0"
                    Click="Quit_Click" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                <TextBlock x:Name="TrayLangKo" Text="한국어" Tag="Korean" FontSize="12.5"
                           Cursor="Hand" Padding="6,3" MouseLeftButtonUp="TrayLang_Click" />
                <TextBlock Text="·" Foreground="#D1D6DB" FontSize="12.5" VerticalAlignment="Center" />
                <TextBlock x:Name="TrayLangJa" Text="日本語" Tag="Japanese" FontSize="12.5"
                           Cursor="Hand" Padding="6,3" MouseLeftButtonUp="TrayLang_Click" />
                <TextBlock Text="·" Foreground="#D1D6DB" FontSize="12.5" VerticalAlignment="Center" />
                <TextBlock x:Name="TrayLangEn" Text="English" Tag="English" FontSize="12.5"
                           Cursor="Hand" Padding="6,3" MouseLeftButtonUp="TrayLang_Click" />
            </StackPanel>

            <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0">
                <Hyperlink Foreground="#B0B8C1" TextDecorations="None" Click="DisableAutostart_Click">
                    <Run x:Name="DisableAutostartRun" FontSize="12" />
                </Hyperlink>
            </TextBlock>
        </StackPanel>
    </Border>
</Window>
