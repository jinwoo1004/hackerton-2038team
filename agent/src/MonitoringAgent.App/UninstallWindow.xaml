<Window x:Class="MonitoringAgent.App.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monitoring Agent"
        Width="400" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Malgun Gothic" TextOptions.TextFormattingMode="Ideal">

    <Border Background="White" CornerRadius="24" Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.15" Color="#000000" />
        </Border.Effect>

        <Grid Margin="32,26,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Button Grid.Row="0" Style="{StaticResource CloseButton}" HorizontalAlignment="Right"
                    Margin="0,-8,-8,0" Click="Cancel_Click" />

            <StackPanel Grid.Row="1">
                <Image Source="/MonitoringAgentApp;component/Assets/logo_app.png" Width="68" Height="68" HorizontalAlignment="Center" />

                <TextBlock x:Name="UninstallTitle" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource Ink}" HorizontalAlignment="Center" Margin="0,20,0,0" />
                <TextBlock x:Name="UninstallSubtitle" FontSize="14" Foreground="{StaticResource Sub}" TextAlignment="Center"
                           TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0" />

                <TextBlock x:Name="ErrorText" FontSize="13" Foreground="#F04A4A" TextAlignment="Center"
                           TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,14,0,0" Visibility="Collapsed" />

                <Button x:Name="DeleteButton" Style="{StaticResource PrimaryButton}" Margin="0,24,0,0"
                        Click="Delete_Click" />
                <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Margin="0,8,0,0"
                        Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
