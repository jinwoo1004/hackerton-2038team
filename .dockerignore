**/auth.json
**/*.auth.json
**/.env
**/.env.*
!**/.env.example
.demo
.work
.tools
**/node_modules
**/.next*
**/.venv
**/.gradle
**/data
**/storage
**/*.log
**/application-local.yml
**/application-secrets.yml
